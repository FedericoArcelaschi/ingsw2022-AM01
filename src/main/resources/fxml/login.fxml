<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane fx:id="loginPane" prefHeight="500" prefWidth="600" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.userInterface.gui.controller.LoginPaneController">
   <children>
      <Label fx:id="eriantysLabel" layoutX="257" layoutY="52" text="Eriantys">
         <font>
            <Font size="25" />
         </font>
      </Label>

      <Pane fx:id="preferencesPane" layoutX="100" layoutY="140" prefHeight="310" prefWidth="383">
         <children>
            <Text fx:id="preferencesLabel" strokeType="OUTSIDE" strokeWidth="0" text="Preferences">
               <font><Font size="18" /></font>
            </Text>
            <Label fx:id="usernameLabel" layoutY="50" text="Username:" />
            <TextField fx:id="usernameTextField" layoutX="90" layoutY="45" />
            <Label fx:id="gameLabel" layoutY = "100" text="Game type:"/>
            <RadioButton fx:id="player2RadioButton" layoutX="90" layoutY="100" mnemonicParsing="false" text="2 Players" />
            <RadioButton fx:id="player3RadioButton" layoutX="200" layoutY="100" mnemonicParsing="false" text="3 Players" />
            <RadioButton fx:id="player4RadioButton" layoutX="310" layoutY="100" mnemonicParsing="false" text="4 Players" />
            <CheckBox fx:id="expertModeButton" layoutX="90" layoutY="135" mnemonicParsing="false" text="Expert" />
            <Label fx:id="networkLabel" layoutY = "180" text="Network:"/>
            <Label fx:id="ipLabel" layoutX="90" layoutY="180" text="IP:" />
            <TextField fx:id="ipTextField" layoutX="90" layoutY="195" promptText="127.0.0.1" />
            <Label fx:id="portLabel" layoutX="88" layoutY="230" text="Port:" />
            <TextField fx:id="portTextField" layoutX="90" layoutY="245" promptText="1234" />
         </children>
      </Pane>
      <Button fx:id="submitButton" layoutX="530" layoutY="460" mnemonicParsing="false" onAction="#submitPreferences" text="Submit" />
   </children>
</Pane>
