<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<Pane fx:id="loginPane" prefHeight="500" prefWidth="600" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.client.userInterface.gui.controller.LoginPaneController">
   <children>
      <Label fx:id="eriantysLabel" layoutX="257" layoutY="52" text="Eriantys">
         <font>
            <Font size="25" />
         </font>
      </Label>

      <Pane layoutX="100.0" layoutY="140.0" prefHeight="310.0" prefWidth="383.0">
         <children>
            <StackPane>
               <children>
                  <Pane fx:id="preferencesPane">
                     <children>
                        <Text fx:id="preferencesLabel" layoutY="17.0" strokeType="OUTSIDE" strokeWidth="0" text="Preferences">
                           <font>
                              <Font size="18" />
                           </font>
                        </Text>
                        <Label fx:id="usernameLabel" layoutY="47.40234375" text="Username:" />
                        <TextField fx:id="usernameTextField" layoutX="90.0" layoutY="42.40234375" />
                        <Label fx:id="gameLabel" layoutY="97.40234375" text="Game type:" />
                        <RadioButton fx:id="player2RadioButton" layoutX="90.0" layoutY="97.40234375" mnemonicParsing="false" text="2 Players" />
                        <RadioButton fx:id="player3RadioButton" layoutX="200.0" layoutY="97.40234375" mnemonicParsing="false" text="3 Players" />
                        <RadioButton fx:id="player4RadioButton" layoutX="310.0" layoutY="97.40234375" mnemonicParsing="false" text="4 Players" />
                        <CheckBox fx:id="expertModeButton" layoutX="90.0" layoutY="132.40234375" mnemonicParsing="false" text="Expert" />
                     </children>
                  </Pane>
                  <Pane fx:id="waitingForGamePane" layoutX="10.0" layoutY="10.0" visible="false">
                     <children>
                        <Label layoutX="90.0" layoutY="66.0" text="Waiting for other players to join...">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                     </children>
                  </Pane>
               </children>
            </StackPane>
            <StackPane layoutY="180.0" prefHeight="130.0" prefWidth="383.0">
               <children>
                  <Pane fx:id="networkPane">
                     <children>
                        <Label fx:id="networkLabel" text="Network:" />
                        <Label fx:id="ipLabel" layoutX="90.0" text="IP:" />
                        <TextField fx:id="ipTextField" layoutX="90.0" layoutY="15.0" promptText="127.0.0.1" />
                        <Label fx:id="portLabel" layoutX="88.0" layoutY="50.0" text="Port:" />
                        <TextField fx:id="portTextField" layoutX="90.0" layoutY="65.0" promptText="12345" />
                        <Button layoutX="292.0" layoutY="66.0" mnemonicParsing="false" onAction="#connect" text="Connect" />
                     </children>
                  </Pane>
                  <TableView fx:id="lobbyTable" prefHeight="165.0" prefWidth="383.0" visible="false">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </StackPane>
         </children>
      </Pane>
      <Button fx:id="submitButton" defaultButton="true" disable="true" layoutX="530" layoutY="460" mnemonicParsing="false" onAction="#submitPreferences" text="Play" />
   </children>
</Pane>
